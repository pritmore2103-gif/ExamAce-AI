# Existing ExamAce settings
GEMINI_API_KEY=your_gemini_api_key
JWT_SECRET_KEY=your_long_random_jwt_secret
FRONTEND_URL=https://your-frontend-domain.example

# Razorpay Test Mode
# Generate these from Razorpay Dashboard > Account & Settings > API Keys.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# Create a monthly ₹699 Pro plan in Razorpay Dashboard and paste its plan ID here.
RAZORPAY_PLAN_ID=plan_xxxxxxxxxxxxx

# Create a webhook in Razorpay Dashboard pointing to:
# https://your-backend-domain.example/payments/razorpay-webhook
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
